pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build Image') {
            steps {
                bat 'docker build -t jenkins-app:build-%BUILD_NUMBER% .'
            }
        }
        stage('Deploy & Verify') {
            steps {
                bat '''
                docker stop jenkins-app 2>NUL
                docker rm jenkins-app 2>NUL
                docker run -d --name jenkins-app -p 8081:80 jenkins-app:build-%BUILD_NUMBER%
                docker ps --filter "name=jenkins-app"
                curl -f http://localhost:8081
                '''
            }
        }
    }
    post {
        success { echo 'Pipeline completed successfully!' }
        failure { echo 'Pipeline failed.' }
    }
}
