pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Test') {
            steps {
                bat 'if not exist index.html exit /b 1'
            }
        }
        stage('Build Docker Image') {
            steps {
                bat 'docker build -t own-scenario-web .'
            }
        }
        stage('Deploy') {
            steps {
                bat '''
                docker stop own-scenario-web 2>NUL
                docker rm own-scenario-web 2>NUL
                docker run -d --name own-scenario-web -p 8085:80 own-scenario-web
                '''
            }
        }
        stage('Verify') {
            steps {
                bat 'curl -f http://localhost:8085'
            }
        }
    }
}
