pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build Docker Image') {
            steps { bat 'docker build -t git-docker-jenkins-app .' }
        }
        stage('Run Container') {
            steps {
                bat '''
                docker stop git-docker-jenkins-app 2>NUL
                docker rm git-docker-jenkins-app 2>NUL
                docker run -d --name git-docker-jenkins-app -p 8081:80 git-docker-jenkins-app
                '''
            }
        }
    }
}
